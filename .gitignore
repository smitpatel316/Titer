node_modules/
dist/
r-packages/
src-tauri/target/
src-tauri/mcp-bridge/target/
src-tauri/gen/
broker/target/
.DS_Store

# v3 stdio bridge (Phase 1): staged sidecar binaries + built .mcpb bundles are
# build artefacts, never committed. Sources: src-tauri/mcp-bridge/,
# mcpb/manifest.json; staging: scripts/build-stdio-bridge.sh, scripts/pack-mcpb.sh.
src-tauri/binaries/
src-tauri/mcp-bridge/target/
mcpb/server/
*.mcpb

# Linux dev/test run artefacts (logs, pid files, probe scripts)
logs/

# Vendored webR package repo (plan 00): build artefact, not source — it is
# 57 MB of .tgz files rebuilt by scripts/build-webr-repo.sh from the pinned
# manifest. Never commit it; a build without it falls back to the CDN.
webr-repo/

# QA notes (*.md, any depth) are tracked; all other QA artefacts
# (screenshots, logs, fixtures) stay uncommitted.
qa/**
!qa/**/
!qa/**/*.md
# Screenshot-test references ONLY: PNG/SVG files anywhere under a
# qa/**/reference/ dir may be committed (inventory §4 — the allowlist is
# deliberate, so a reference lands only when a lane puts it there).
# Anything else non-md under qa/ stays ignored. (The trailing /**/ is
# needed: references live one level down, qa/reference/<case>/file.png.)
!qa/**/reference/**/*.png
!qa/**/reference/**/*.svg
test-corpus/

# e2e (spike/tauri-e2e): temp outputs, scratch app-data dir, wdio logs.
e2e/out/
e2e/.e2e-home/
e2e/logs/
